// FlClash (mihomo >= v1.19.27) 脚本覆写：内嵌 Tailscale 出站 (支持短域名自动解析)

function main(config) {
  // ========== 按需修改 ==========
  const NODE_NAME = "Tailscale";
  const TAILSCALE_AUTH_KEY = "tskey-auth-xxxxxxxxxxxx"; // 换成你的 auth key
  const TAILSCALE_HOSTNAME = "flclash-node-t0";            // 在 tailnet 里显示的设备名
  // ===============================

  // ---------- 1. 添加 Tailscale 出站节点 ----------
  if (!Array.isArray(config.proxies)) config.proxies = [];
  
  if (!config.proxies.some((p) => p.name === NODE_NAME)) {
    config.proxies.push({
      name: NODE_NAME,
      type: "tailscale",
      "auth-key": TAILSCALE_AUTH_KEY,
      hostname: TAILSCALE_HOSTNAME,
      udp: true,
      "accept-routes": true, 
      "state-dir": "tailscale-state",
    });
  }

  // ---------- 2. 将节点挂载进手动选择或代理组 ----------
  if (Array.isArray(config["proxy-groups"])) {
    config["proxy-groups"].forEach((g) => {
      if (
        (g.type === "select" || g.type === "url-test") &&
        Array.isArray(g.proxies) &&
        g.proxies.indexOf(NODE_NAME) === -1 &&
        g.name !== NODE_NAME
      ) {
        if (g.type === "select") g.proxies.push(NODE_NAME);
      }
    });
  }

  // ---------- 3. 定义短域名正则匹配规则 ----------
  // 匹配所有不包含点号 `.` 的单标签域名（例如 nas, router, web 等）
  const shortDomainRegex = "^[^.]+$";

  // ---------- 4. 路由规则注入 ----------
  const tailscaleRules = [
    `DOMAIN,localhost,DIRECT`,                           // 优先直连 localhost，防止系统保留短名被正则捕获并发送至 tailnet
    `IP-CIDR,100.64.0.0/10,${NODE_NAME},no-resolve`,     // Tailscale CGNAT 官方网段
    `DOMAIN-SUFFIX,ts.net,${NODE_NAME}`,                 // 完整 MagicDNS 域名直接走 Tailscale
    `DOMAIN-REGEX,${shortDomainRegex},${NODE_NAME}`      // 【核心】拦截所有短域名，强制交由 Tailscale 出站处理
  ];
  
  const oldRules = Array.isArray(config.rules) ? config.rules : [];
  config.rules = tailscaleRules.concat(
    oldRules.filter((r) => tailscaleRules.indexOf(r) === -1)
  );

  // ---------- 5. DNS 配置深度劫持 ----------
  if (!config.dns) config.dns = {};

  // 5.1 过滤 Fake-IP：确保短域名获取的是 tailnet 的真实 100.x IP，避免与代理机制冲突
  if (!Array.isArray(config.dns["fake-ip-filter"])) {
    config.dns["fake-ip-filter"] = [];
  }
  const fakeIpFilters = ["+.ts.net", `regex:${shortDomainRegex}`];
  fakeIpFilters.forEach(filter => {
    if (config.dns["fake-ip-filter"].indexOf(filter) === -1) {
      config.dns["fake-ip-filter"].push(filter);
    }
  });

  // 5.2 DNS 解析策略：强制短域名的 DNS 解析走 MagicDNS 
  if (!config.dns["nameserver-policy"] || typeof config.dns["nameserver-policy"] !== "object") {
    config.dns["nameserver-policy"] = {};
  }
  
  // 原有的 ts.net 后缀走 MagicDNS
  config.dns["nameserver-policy"]["+.ts.net"] = `100.100.100.100#${NODE_NAME}`;
  // 【核心】不带后缀的短域名同样交由 MagicDNS 解析
  config.dns["nameserver-policy"][`regex:${shortDomainRegex}`] = `100.100.100.100#${NODE_NAME}`;

  // 由于实现了自动解析，不再需要强行写入 config.hosts
  return config;
}
