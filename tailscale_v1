// FlClash (mihomo >= v1.19.27) 脚本覆写：内嵌 Tailscale 出站强化版
// 原理：mihomo 原生 type: tailscale 节点基于 tsnet 运行在用户态，
// 无需系统级 TUN 即可加入 tailnet，支持 MagicDNS 与子网路由。

function main(config) {
  // ==================== 1. 用户配置区 ====================
  const NODE_NAME = "Tailscale";
  const TAILSCALE_AUTH_KEY = "tskey-auth-xxxxxxxxxxxx"; // 替换为你的 Auth Key (建议 Pre-authenticated / Reusable)
  const TAILSCALE_HOSTNAME = "flclash-node-test0";             // 设备在 Tailnet 中显示的 Hostname
  // const HEADSCALE_URL = "https://headscale.example.com"; // 自建 Headscale 控制端地址（按需开启）

  // 短名静态解析映射：将短名直接钉死到对应的 Tailscale IP
  const TAILNET_HOSTS = {
    // "nas": "100.101.102.103",
    // "pve": "100.101.102.104",
  };

  // 子网路由（Subnet Router）网段：若家中节点通告了内网网段，填在此处强制走 Tailscale
  const SUBNET_ROUTES = [
    // "192.168.1.0/24",
    // "10.0.0.0/24",
  ];

  // 策略组黑名单：不希望注入 Tailscale 节点的策略组名称关键词
  const EXCLUDE_GROUPS = ["自动", "Auto", "DIRECT", "直连", "漏网之鱼"];
  // =======================================================


  // ==================== 2. 注入 Tailscale 节点 ====================
  if (!Array.isArray(config.proxies)) {
    config.proxies = [];
  }

  const existingNodeIndex = config.proxies.findIndex((p) => p.name === NODE_NAME);
  const tailscaleNodeConfig = {
    name: NODE_NAME,
    type: "tailscale",
    "auth-key": TAILSCALE_AUTH_KEY,
    hostname: TAILSCALE_HOSTNAME,
    udp: true,
    "accept-routes": true,         // 接受 Subnet Router 通告的路由
    "state-dir": "tailscale-state",// 持久化节点状态，避免重启后重新认证
    // "control-url": HEADSCALE_URL,
  };

  if (existingNodeIndex === -1) {
    config.proxies.push(tailscaleNodeConfig);
  } else {
    config.proxies[existingNodeIndex] = tailscaleNodeConfig;
  }


  // ==================== 3. 挂载到策略组 ====================
  if (Array.isArray(config["proxy-groups"])) {
    config["proxy-groups"].forEach((group) => {
      // 仅挂载到手动选择组（select），且排除特定语义的策略组
      const isSelectGroup = group.type === "select";
      const isNotExcluded = !EXCLUDE_GROUPS.some((keyword) => group.name.includes(keyword));
      const notSelf = group.name !== NODE_NAME;

      if (isSelectGroup && isNotExcluded && notSelf && Array.isArray(group.proxies)) {
        if (!group.proxies.includes(NODE_NAME)) {
          group.proxies.push(NODE_NAME);
        }
      }
    });
  }


  // ==================== 4. 路由分流规则注入 ====================
  const tailscaleRules = [
    // Tailscale IPv4 CGNAT 地址段
    `IP-CIDR,100.64.0.0/10,${NODE_NAME},no-resolve`,
    // Tailscale IPv6 地址段（防止 IPv6 流量泄漏）
    `IP-CIDR6,fd7a:115c:a1e0::/48,${NODE_NAME},no-resolve`,
    // MagicDNS 完整域名后缀
    `DOMAIN-SUFFIX,ts.net,${NODE_NAME}`,
  ];

  // 注入 Subnet Router 子网路由规则
  SUBNET_ROUTES.forEach((cidr) => {
    tailscaleRules.push(`IP-CIDR,${cidr},${NODE_NAME},no-resolve`);
  });

  const originalRules = Array.isArray(config.rules) ? config.rules : [];
  // 确保 Tailscale 路由置顶生效，并过滤掉已有的重复规则
  config.rules = tailscaleRules.concat(
    originalRules.filter((rule) => !tailscaleRules.includes(rule))
  );


  // ==================== 5. DNS 与 Fake-IP 策略 ====================
  if (!config.dns || typeof config.dns !== "object") {
    config.dns = {};
  }

  // 初始化 fake-ip-filter，防止内网域名被映射为 Fake-IP
  if (!Array.isArray(config.dns["fake-ip-filter"])) {
    config.dns["fake-ip-filter"] = [];
  }
  const fakeIpFilters = ["+.ts.net", ...Object.keys(TAILNET_HOSTS)];
  fakeIpFilters.forEach((filterDomain) => {
    if (!config.dns["fake-ip-filter"].includes(filterDomain)) {
      config.dns["fake-ip-filter"].push(filterDomain);
    }
  });

  // 配置 MagicDNS 解析策略（通过 Tailscale 出站查询内部 DNS 100.100.100.100）
  if (!config.dns["nameserver-policy"] || typeof config.dns["nameserver-policy"] !== "object") {
    config.dns["nameserver-policy"] = {};
  }
  config.dns["nameserver-policy"]["+.ts.net"] = `100.100.100.100#${NODE_NAME}`;


  // ==================== 6. 短名 Hosts 静态绑定 ====================
  const hostKeys = Object.keys(TAILNET_HOSTS);
  if (hostKeys.length > 0) {
    if (!config.hosts || typeof config.hosts !== "object") {
      config.hosts = {};
    }
    hostKeys.forEach((name) => {
      config.hosts[name] = TAILNET_HOSTS[name];
    });
    config.dns["use-hosts"] = true; // 确保 hosts 规则生效
  }

  return config;
}
