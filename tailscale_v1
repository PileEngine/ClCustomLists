// FlClash (mihomo >= v1.19.27) 脚本覆写：内嵌 Tailscale 出站
// 原理：mihomo 原生 type: tailscale 节点基于 tsnet，纯用户态加入 tailnet。
// 修复版：完善了 MagicDNS 的 UDP 代理查询语法与通配匹配规则。

function main(config) {
  // ========== 按需修改 ==========
  const NODE_NAME = "Tailscale";
  const TAILSCALE_AUTH_KEY = "tskey-auth-xxxxxxxxxxxx"; // 换成你的 auth key
  const TAILSCALE_HOSTNAME = "flclash-node-t0";            // 在 tailnet 里显示的设备名
  // ===============================

  // ---------- 1. 添加 Tailscale 出站节点 ----------
  if (!Array.isArray(config.proxies)) config.proxies = [];

  if (!config.proxies.some((p) => p.name === NODE_NAME)) {
    config.proxies.push({
      name: NODE_NAME,
      type: "tailscale",
      "auth-key": TAILSCALE_AUTH_KEY,
      hostname: TAILSCALE_HOSTNAME,
      udp: true,
      "accept-routes": true,
      "state-dir": "tailscale-state",
    });
  }

  // ---------- 2. 挂进已有的手动选择/代理组 ----------
  if (Array.isArray(config["proxy-groups"])) {
    config["proxy-groups"].forEach((g) => {
      if (
        (g.type === "select" || g.type === "url-test") &&
        Array.isArray(g.proxies) &&
        g.proxies.indexOf(NODE_NAME) === -1 &&
        g.name !== NODE_NAME
      ) {
        if (g.type === "select") g.proxies.push(NODE_NAME);
      }
    });
  }

  // ---------- 3. 路由规则：tailnet 流量走 Tailscale 节点 ----------
  const tailscaleRules = [
    `IP-CIDR,100.64.0.0/10,${NODE_NAME},no-resolve`,
    `DOMAIN-SUFFIX,ts.net,${NODE_NAME}`,
  ];
  const oldRules = Array.isArray(config.rules) ? config.rules : [];
  config.rules = tailscaleRules.concat(
    oldRules.filter((r) => tailscaleRules.indexOf(r) === -1)
  );

  // ---------- 4. DNS：修复 MagicDNS 解析逻辑 ----------
  if (!config.dns) config.dns = {};

  if (!Array.isArray(config.dns["fake-ip-filter"])) {
    config.dns["fake-ip-filter"] = [];
  }
  
  // 【修复1】增加更严谨的通配符，防止部分内核版本对 +.ts.net 过滤遗漏
  const tsFilters = ["+.ts.net", "*.ts.net", "ts.net"];
  tsFilters.forEach(domain => {
    if (config.dns["fake-ip-filter"].indexOf(domain) === -1) {
      config.dns["fake-ip-filter"].push(domain);
    }
  });

  if (!config.dns["nameserver-policy"] || typeof config.dns["nameserver-policy"] !== "object") {
    config.dns["nameserver-policy"] = {};
  }
  
  // 【修复2】第一性原理：必须显式声明 udp:// 和 53 端口。
  // 原先的 "100.100.100.100#Node" 会被部分解析器退化为 TCP 请求或因特殊字符解析报错
  const tsDnsServer = `udp://100.100.100.100:53#${NODE_NAME}`;
  config.dns["nameserver-policy"]["+.ts.net"] = tsDnsServer;
  config.dns["nameserver-policy"]["*.ts.net"] = tsDnsServer;

  // ---------- 5. 别名（短名）访问映射 ----------
  const TAILNET_HOSTS = {
    // "短名": "100.x.y.z", 
  };

  if (Object.keys(TAILNET_HOSTS).length > 0) {
    if (!config.hosts || typeof config.hosts !== "object") config.hosts = {};
    Object.keys(TAILNET_HOSTS).forEach((name) => {
      config.hosts[name] = TAILNET_HOSTS[name];
    });
    config.dns["use-hosts"] = true;
  }

  return config;
}
