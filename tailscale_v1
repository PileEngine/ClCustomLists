/**
 * Mihomo 内核 Tailscale 注入与 MagicDNS 覆写脚本
 * 适用环境：Clash Verge Rev / Mihomo Party / Clash Nyanpasu 扩展脚本
 */
function main(config) {
  // 1. 配置参数常量
  const TAILSCALE_CONFIG = {
    proxyName: "Tailscale-Node",                  // 代理节点名称
    hostname: "mihomo-client",                   // 注册到 Tailscale 控制台的设备名
    authKey: "tskey-auth-xxxxxxxxxxxx",          // 替换为 Tailscale Auth Key (需设置为 Reusable & Pre-Approved)
    controlUrl: "https://controlplane.tailscale.com", // 自建 Headscale 用户可替换为对应 URL
    stateDir: "./tailscale-state",               // 持久化存储目录（存储设备密钥与认证状态，重启不重复注册）
    ephemeral: false,                            // false: 设备长期保留；true: 离线自动注销
    tailnetSuffix: "+.ts.net",                   // 你的 Tailnet 域名后缀（如: +.your-domain.ts.net）
    magicDnsIp: "100.100.100.100"                // Tailscale MagicDNS 默认 DNS 服务器 IP
  };

  // 2. 构造 Tailscale Proxy 节点
  const tailscaleProxy = {
    name: TAILSCALE_CONFIG.proxyName,
    type: "tailscale",
    hostname: TAILSCALE_CONFIG.hostname,
    "auth-key": TAILSCALE_CONFIG.authKey,
    "control-url": TAILSCALE_CONFIG.controlUrl,
    "state-dir": TAILSCALE_CONFIG.stateDir,
    ephemeral: TAILSCALE_CONFIG.ephemeral,
    udp: true
  };

  // 3. 注入 Proxy 节点列表
  if (!Array.isArray(config.proxies)) {
    config.proxies = [];
  }
  // 过滤掉同名节点，避免热重载重复注入
  config.proxies = config.proxies.filter(p => p.name !== TAILSCALE_CONFIG.proxyName);
  config.proxies.push(tailscaleProxy);

  // 4. 将 Tailscale 节点追加到策略组（可选，方便手动切换或分流）
  if (Array.isArray(config["proxy-groups"])) {
    config["proxy-groups"].forEach(group => {
      if (["GLOBAL", "PROXY", "节点选择", "FINAL"].includes(group.name)) {
        if (Array.isArray(group.proxies) && !group.proxies.includes(TAILSCALE_CONFIG.proxyName)) {
          group.proxies.push(TAILSCALE_CONFIG.proxyName);
        }
      }
    });
  }

  // 5. 配置 DNS 自定义域名解析 (MagicDNS 路由)
  if (!config.dns) {
    config.dns = { enable: true };
  }
  if (!config.dns["nameserver-policy"]) {
    config.dns["nameserver-policy"] = {};
  }
  
  // 将 Tailnet 设备域名 (*.ts.net) 路由至 Tailscale 内置 MagicDNS 解析
  config.dns["nameserver-policy"][TAILSCALE_CONFIG.tailnetSuffix] = TAILSCALE_CONFIG.magicDnsIp;

  // 6. 注入分流规则（保证匹配 MagicDNS 与 Tailscale CGNAT 网段流量走 Tailscale 节点）
  const tailscaleRules = [
    // 拦截 MagicDNS 查询及 Tailscale 内网 CGNAT 目标 IP (100.64.0.0/10)
    `IP-CIDR,100.64.0.0/10,${TAILSCALE_CONFIG.proxyName},no-resolve`,
    // 拦截 Tailnet 自定义设备域名后缀，走 Tailscale 节点转发
    `DOMAIN-SUFFIX,ts.net,${TAILSCALE_CONFIG.proxyName}`,
    // 控制平面域名直连，防止建立隧道时出现死循环
    "DOMAIN-SUFFIX,tailscale.com,DIRECT",
    "DOMAIN-SUFFIX,tailscale.io,DIRECT"
  ];

  if (!Array.isArray(config.rules)) {
    config.rules = [];
  }
  // 插入到规则首部，确保最高优先级匹配
  config.rules = [...tailscaleRules, ...config.rules];

  return config;
}
