// Mihomo Tailscale + Fake-IP + gVisor TUN 覆写脚本
function main(config) {
  // 1. 初始化基础对象
  if (!config.proxies) config.proxies = [];
  if (!config.rules) config.rules = [];
  if (!config.dns) config.dns = {};
  if (!config.tun) config.tun = {};

  // 2. 强制配置 TUN 模块为 gVisor 模式
  config.tun = {
    ...config.tun,
    enable: true,
    stack: "gvisor", // 采用 gvisor 用户态网络栈
    "dns-hijack": ["any:53", "tcp://any:53"],
    "auto-route": true,
    "auto-detect-interface": true
  };

  // 3. 配置 DNS 为 Fake-IP 模式
  config.dns = {
    ...config.dns,
    enable: true,
    "enhanced-mode": "fake-ip",
    "fake-ip-range": "198.18.0.1/16"
  };

  // 4. 定义 Tailscale 代理节点
  const tailscaleProxy = {
    name: "Tailscale",
    type: "tailscale",
    hostname: "clash-mihomo", // Tailnet 中显示的设备名称
    "auth-key": "tskey-auth-xxxxxxxxxxxx", // 替换为你的 Tailscale 授权密钥（首次认证使用）
    // "control-url": "https://headscale.example.com", // 若使用 Headscale，取消注释并填入地址
    "state-dir": "./tailscale", // 关键：持久化目录，确保证书与网络状态不丢失
    ephemeral: false, // 关键：保持节点永久有效，不随离线自动销毁
    udp: true, // 必须开启 UDP 以保证 WireGuard 隧道性能
    "accept-routes": true // 接收 Tailnet 中 Subnet Router 发布的内网子网路由
    // "exit-node": "100.64.0.1", // 若需使用指定 Exit Node 出口网关可配置
  };

  // 移除旧的同名节点并注入新节点
  config.proxies = config.proxies.filter(p => p.name !== tailscaleProxy.name);
  config.proxies.push(tailscaleProxy);

  // 5. 自动将 Tailscale 节点加入全局/默认策略组（可选）
  if (Array.isArray(config["proxy-groups"])) {
    config["proxy-groups"].forEach(group => {
      if (group.name === "GLOBAL" || group.name === "PROXY") {
        if (!group.proxies.includes(tailscaleProxy.name)) {
          group.proxies.push(tailscaleProxy.name);
        }
      }
    });
  }

  // 6. 注入 Tailscale 专属路由规则（置顶优先匹配）
  const tailscaleRules = [
    // Tailscale 默认 CGNAT IP 网段（no-resolve 防止反向 DNS 解析死锁）
    "IP-CIDR,100.64.0.0/10,Tailscale,no-resolve",
    
    // Tailscale 官方 MagicDNS 域名后缀
    "DOMAIN-SUFFIX,ts.net,Tailscale",
    
    // 自定义内网域名（请根据你的实际 Tailnet 自定义搜索域或内网域名修改）
    "DOMAIN-SUFFIX,lan,Tailscale",
    "DOMAIN-SUFFIX,local,Tailscale",
    "DOMAIN-SUFFIX,internal.example.com,Tailscale"
    
    // 若 Tailnet 中配置了子网路由器（Subnet Router，例如 192.168.100.0/24），取消下一行注释：
    // "IP-CIDR,192.168.100.0/24,Tailscale,no-resolve"
  ];

  config.rules = [...tailscaleRules, ...config.rules];

  return config;
}
